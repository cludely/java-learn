<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="user">
    <!-- id 是 sql 语句的唯一标识 -->
    <insert id="insertUser">
        insert into t_user
            (id, name, age, sex)
        value
            (null, '黄俊杰', 12, '男')
    </insert>

</mapper>