<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="user">
    <!-- id 是 sql 语句的唯一标识 -->
    <insert id="insertUser">
        insert into t_user
        (id, name, age, sex)
        value
        (null, #{name}, #{age}, #{sex})
    </insert>

    <!-- parameterType 用来指定参数的类型，大部分情况下不用写 -->
    <!-- #{name} 底层会优先调用 user.getName() 方法来获取 name 属性的值 -->
    <!-- 没有 user.getName() 方法则降级为用 user.name 来获取 name 属性的值 -->
    <insert id="insertUser2" parameterType="com.example.mybatis.entity.User">
        insert into t_user
        (id, name, age, sex)
        value
        (null, #{name}, #{age}, #{sex})
    </insert>

    <!-- mybatis 中，当一个SQL语句的占位符只有一个的时候，#{}的内容可以随便写 -->
    <delete id="deleteUserById">
        delete from t_user where id = #{id}
    </delete>

    <update id="updateUserById" parameterType="com.example.mybatis.entity.User">
        update t_user set
            name = #{name},
            age = #{age},
            sex = #{sex}
        where
            id = #{id}
    </update>

    <!-- parameterType 数据将传递给 #{} -->
    <!-- resultType 属性用来告诉 mybatis 框架，将查询结果集封装为什么类型的对象 -->
    <!-- 这里查询到了之后，是通过 set 方法给属性赋值的 -->
    <!-- 若存在数据库字段名与对象字段名对不上的情况，导致对象属性被赋值为 null, 可以用别名来解决 -->
    <!-- 比如数据库中字段名为 user_name，对象属性set方法名为 setName -->
    <!-- 那么可以 user_name as name -->
    <select id="selectUserById" parameterType="Long" resultType="com.example.mybatis.entity.User">
        select
            id, name, age, sex
        from
            t_user
        where
            id = #{id}
    </select>

    <!-- resultType 不是 List，而是 List中具体元素的类型 -->
    <select id="selectUserAll" resultType="com.example.mybatis.entity.User">
        select
            id, name, age, sex
        from
            t_user
    </select>

</mapper>