<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="user">
    <!-- id 是 sql 语句的唯一标识 -->
    <insert id="insertUser">
        insert into t_user
        (id, name, age, sex)
        value
        (null, #{name}, #{age}, #{sex})
    </insert>

    <!-- parameterType 用来指定参数的类型，大部分情况下不用写 -->
    <!-- #{name} 底层会优先调用 user.getName() 方法来获取 name 属性的值 -->
    <!-- 没有 user.getName() 方法则降级为用 user.name 来获取 name 属性的值 -->
    <insert id="insertUser2" parameterType="com.example.mybatis.entity.User">
        insert into t_user
        (id, name, age, sex)
        value
        (null, #{name}, #{age}, #{sex})
    </insert>

    <!-- mybatis 中，当一个SQL语句的占位符只有一个的时候，#{}的内容可以随便写 -->
    <delete id="deleteUserById">
        delete from t_user where id = #{id}
    </delete>

    <update id="updateUserById" parameterType="com.example.mybatis.entity.User">
        update t_user set
            name = #{name},
            age = #{age},
            sex = #{sex}
        where
            id = #{id}
    </update>

</mapper>